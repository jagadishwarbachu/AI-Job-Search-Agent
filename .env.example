# Copy this file to .env for local reference only.
# Prefer n8n's encrypted credential store for production secrets.

APIFY_API_TOKEN=replace_with_your_apify_token
APIFY_LINKEDIN_ACTOR_ID=replace_with_actor_id
APIFY_DICE_ACTOR_ID=replace_with_actor_id

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_side_key
SUPABASE_JOBS_TABLE=jobs

OPENAI_API_KEY=replace_with_your_openai_api_key
OPENAI_MODEL=replace_with_supported_model_name

GMAIL_RECIPIENT=you@example.com

JOB_MATCH_THRESHOLD=70
JOB_SEARCH_KEYWORDS=machine learning engineer,data scientist,generative ai engineer
JOB_SEARCH_LOCATIONS=United States,Remote
